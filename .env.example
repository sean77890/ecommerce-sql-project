# Copy this file to .env and fill in real values for local development.

# Postgres connection string (e.g. from Neon: https://neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any random long string; used to sign session cookies
SESSION_SECRET=change-me-to-something-random

# Optional, defaults to 3000
PORT=3000
