<%- include('../partials/header', { title: 'Products - SQL Shop' }) %>

<div class="layout">
  <aside class="sidebar">
    <h2>Categories</h2>
    <ul class="category-list">
      <li><a href="/products" class="<%= !activeCategory ? 'active' : '' %>">All</a></li>
      <% categories.forEach(function(cat) { %>
        <li><a href="/products?category=<%= encodeURIComponent(cat.name) %>" class="<%= activeCategory === cat.name ? 'active' : '' %>"><%= cat.name %></a></li>
      <% }); %>
    </ul>
  </aside>

  <section class="product-grid">
    <% if (products.length === 0) { %>
      <p>No products found.</p>
    <% } %>
    <% products.forEach(function(product) { %>
      <a class="product-card" href="/products/<%= product.id %>">
        <img src="<%= product.image_url %>" alt="<%= product.name %>" />
        <h3><%= product.name %></h3>
        <p class="category-tag"><%= product.category_name %></p>
        <p class="price">$<%= (product.price_cents / 100).toFixed(2) %></p>
        <% if (product.stock_qty === 0) { %>
          <p class="stock out">Out of stock</p>
        <% } %>
      </a>
    <% }); %>
  </section>
</div>

<%- include('../partials/footer') %>
