<%- include('../partials/header', { title: 'Order #' + order.id + ' - SQL Shop' }) %>

<h1>Order #<%= order.id %></h1>
<p>Placed on <%= order.created_at %> &mdash; Status: <strong><%= order.status %></strong></p>

<table class="cart-table">
  <thead>
    <tr>
      <th>Product</th>
      <th>Unit Price</th>
      <th>Quantity</th>
      <th>Line Total</th>
    </tr>
  </thead>
  <tbody>
    <% items.forEach(function(item) { %>
      <tr>
        <td><%= item.name %></td>
        <td>$<%= (item.unit_price_cents / 100).toFixed(2) %></td>
        <td><%= item.quantity %></td>
        <td>$<%= ((item.unit_price_cents * item.quantity) / 100).toFixed(2) %></td>
      </tr>
    <% }); %>
  </tbody>
</table>

<p class="price large">Total: $<%= (order.total_cents / 100).toFixed(2) %></p>

<p><a href="/orders">&larr; Back to orders</a></p>

<%- include('../partials/footer') %>
