<%- include('../partials/header', { title: 'Your Orders - SQL Shop' }) %>

<h1>Your Orders</h1>

<% if (orders.length === 0) { %>
  <p>You haven't placed any orders yet. <a href="/products">Start shopping</a>.</p>
<% } else { %>
  <table class="cart-table">
    <thead>
      <tr>
        <th>Order #</th>
        <th>Date</th>
        <th>Status</th>
        <th>Total</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% orders.forEach(function(order) { %>
        <tr>
          <td>#<%= order.id %></td>
          <td><%= order.created_at %></td>
          <td><span class="status-<%= order.status %>"><%= order.status %></span></td>
          <td>$<%= (order.total_cents / 100).toFixed(2) %></td>
          <td class="order-actions">
            <a href="/orders/<%= order.id %>">View</a>
            <% if (order.status === 'placed') { %>
              <form action="/orders/<%= order.id %>/cancel" method="POST" onsubmit="return confirm('Cancel this order? Items will be returned to stock.');">
                <button type="submit" class="link-button">Cancel</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
